# =============================================================================
# SQL Ops Console - 环境变量说明
# =============================================================================
#
# 本项目使用 Doppler 统一管理环境变量，无需手动配置 .env 文件。
#
# 快速开始:
#   1. 安装 Doppler CLI: brew install dopplerhq/cli/doppler
#   2. 登录: doppler login
#   3. 配置项目: make setup
#   4. 启动开发: make dev
#
# 所有环境变量都在 Doppler 中管理:
#   - Console: db-bot-console 项目
#   - Executor: db-bot-executor 项目
#
# =============================================================================
# 以下仅供参考，实际值从 Doppler 获取
# =============================================================================

# -----------------------------------------------------------------------------
# Console (Next.js) 环境变量
# -----------------------------------------------------------------------------

# 数据库连接 (Neon / Vercel Postgres)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth 配置
BETTER_AUTH_SECRET=your-secret-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Executor API 配置
EXECUTOR_BASE_URL=http://localhost:8787
EXECUTOR_SIGNING_SECRET=your-signing-secret-here

# Doppler 集群 Token (用于多集群部署)
# 格式: CLUSTER_DOPPLER_TOKEN_{ENV}[_{REGION}_{NUMBER}]
# CLUSTER_DOPPLER_TOKEN_DEV=dp.st.xxx
# CLUSTER_DOPPLER_TOKEN_PRE=dp.st.xxx
# CLUSTER_DOPPLER_TOKEN_SG_1=dp.st.xxx

# -----------------------------------------------------------------------------
# Executor (Hono) 环境变量
# -----------------------------------------------------------------------------

# 集群标识
CLUSTER_NAME=dev

# API 签名密钥 (与 Console 共享)
EXECUTOR_SIGNING_SECRET=your-signing-secret-here

# 服务配置
PORT=8787
EXECUTOR_BASE_URL=http://localhost:8787

# 目标数据库配置
# 方式 1: 单一连接字符串
DATABASE_URL=mysql://user:password@host:3306/database

# 方式 2: JSON 格式配置
# SERVICE_DB_CONFIG_JSON={"dev":{"polardb_mysql":{"primary":{"host":"...","port":3306,"user":"...","password":"...","database":"..."}}}}

# 方式 3: 单独的环境变量 (格式: {CLUSTER}_{DBTYPE}_{CODE}_{FIELD})
# DEV_POLARDB_MYSQL_PRIMARY_HOST=localhost
# DEV_POLARDB_MYSQL_PRIMARY_PORT=3306
# DEV_POLARDB_MYSQL_PRIMARY_USER=root
# DEV_POLARDB_MYSQL_PRIMARY_PASSWORD=password
# DEV_POLARDB_MYSQL_PRIMARY_DATABASE=mydb

# 方式 4: Doppler Token (用于生产环境)
# TARGET_DB_DOPPLER_TOKEN=dp.st.xxx

# -----------------------------------------------------------------------------
# 阿里云函数计算 (Serverless 部署) - 可选
# -----------------------------------------------------------------------------
# ALIYUN_REGION=cn-shanghai
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
