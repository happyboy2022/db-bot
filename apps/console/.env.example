# =============================================================================
# SQL Ops Console - 环境变量
# =============================================================================
#
# 本项目使用 Doppler 管理环境变量，无需手动配置此文件。
#
# 快速开始:
#   1. 在项目根目录运行: make setup
#   2. 启动开发: make dev
#
# 如果需要手动配置，请复制此文件为 .env.local
# =============================================================================

# 数据库连接 (Neon / Vercel Postgres)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth 配置
# 生成密钥: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here

# 应用 URL (开发环境自动设置)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Executor API 配置 (开发环境自动设置)
EXECUTOR_BASE_URL=http://localhost:8787
EXECUTOR_SIGNING_SECRET=your-signing-secret-here
