# =============================================================================
# SQL Ops Executor - 环境变量
# =============================================================================
#
# 本项目使用 Doppler 管理环境变量，无需手动配置此文件。
#
# 快速开始:
#   1. 在项目根目录运行: make setup
#   2. 启动开发: make dev
#
# 如果需要手动配置，请复制此文件为 .env
# =============================================================================

# 集群标识
CLUSTER_NAME=dev

# API 签名密钥 (与 Console 共享)
EXECUTOR_SIGNING_SECRET=your-signing-secret-here

# 服务配置
PORT=8787
EXECUTOR_BASE_URL=http://localhost:8787

# 目标数据库配置
DATABASE_URL=mysql://user:password@host:3306/database
